# ─── Server ───────────────────────────────────────────────
PORT=3000
# SQLite file. The folder is created automatically.
DATABASE_PATH=./data/app.db

# Dashboard login (HTTP basic auth). Required when WHATSAPP_MODE=cloud.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ─── WhatsApp ─────────────────────────────────────────────
# "mock"  = nothing is sent; messages are logged and shown in the dashboard Simulator.
# "cloud" = real messages through the WhatsApp Business Cloud API.
WHATSAPP_MODE=mock

# Your WhatsApp Business phone number in international format, digits only
# (e.g. 2348012345678). Used to build the wa.me join links.
WHATSAPP_BUSINESS_PHONE=15550001234

# From Meta App Dashboard → WhatsApp → API Setup (only needed for cloud mode)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# From Meta App Dashboard → App settings → Basic → App secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Any random string you choose; paste the same value into the webhook config in Meta.
WHATSAPP_VERIFY_TOKEN=pick-a-long-random-string
WHATSAPP_API_VERSION=v23.0

# ─── Sending ──────────────────────────────────────────────
# Max messages per second sent by the scheduler (Cloud API default throughput is ~80/s).
SEND_RATE_PER_SECOND=20
# How often the scheduler checks for due messages.
SCHEDULER_INTERVAL_MS=15000

# ─── Attachments ──────────────────────────────────────────
# Where uploaded files are kept (defaults to an "uploads" folder next to the database).
# MEDIA_DIR=./data/uploads
